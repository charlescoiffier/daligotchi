{
  "name": "@daligotchi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "admin": "tsx --env-file-if-exists=../../.env src/admin/cli.ts"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@daligotchi/core": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}
